  "Q3_symplectic_invariance": {
    "symplectic_invariance": {
      "tests": [
        {
          "map": "identity",
          "c_original": 7.0685834705770345,
          "c_mapped": 7.0685834705770345,
          "ratio": 1.0,
          "invariant": true
        },
        {
          "map": "rotation",
          "c_original": 7.0685834705770345,
          "c_mapped": 7.0685834705770345,
          "ratio": 1.0,
          "invariant": true
        },
        {
          "map": "shear",
          "c_original": 7.0685834705770345,
          "c_mapped": 7.0685834705770345,
          "ratio": 1.0,
          "invariant": true
        },
        {
          "map": "symplectic_scale(2)",
          "c_original": 7.0685834705770345,
          "c_mapped": 7.0685834705770345,
          "ratio": 1.0,
          "invariant": true
        },
        {
          "map": "non_symplectic_scale",
          "c_original": 7.0685834705770345,
          "c_mapped": 14.137166941154073,
          "ratio": 2.0000000000000004,
          "invariant": false
        }
      ],
      "all_symp_maps_invariant": true,
      "non_symplectic_detected": true,
      "verdict": "PASS",
      "insight": "Symplectic invariance: c(phi(M)) = c(M) for symplectomorphisms. The 0/0 c(phi(M))/c(M) has removable value 1. Non-symplectic maps break invariance (capacity changes)."
    }
