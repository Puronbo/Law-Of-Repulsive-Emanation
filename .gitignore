# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg
venv/
.venv/
.env
.pytest_cache/

# Generated data artifacts (both canonical data/ and legacy Universals/ locations)
#
# Persistence rule (2026-09-28): a generated artifact is NOT stored, so it
# persists only if regen_data.py can find its generating script. The
# artifact -> script map is itself the standard, so it IS tracked.
# `python regen_data.py --manifest` regenerates it; `--regen PATTERN`
# recreates artifacts. Anything regen_data.py reports under
# "unreproducible" is a genuine loss - currently 42, of which 17 are
# load-bearing for tests/*.py. See docs/PREDICTION_LEDGER.md PL-23.
data/*.json
data/*.dot
data/*.npz
!data/DATA_MANIFEST.json
!data/mersenne_prime_5630.json
!data/mersenne_m52_bridge.json
!data/googol_census.json
!data/epoch_0d.json
!data/sigma_export.json
!data/sigma_framework.json
Universals/*.json
Universals/*.dot

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Lean build artifacts
.lake/
lake-manifest.json

# Databases & local runtime state
*.db
*.sqlite
*.sqlite3
*.db-journal

# Backups
**/*.bak
**/*.backup
debug_output/

# Archives in archive/
archive/

# Origin-lane mirror of Millennium-Prize-Problem-Lean-4-Proof
# (informational byte-mirror for scripts/twin_byte_check.py, not tracked;
#  contains a 6.5 GB warm .lake package cache)
fcc2/

# Scripts that are not part of the core
scripts/*
!scripts/genesis_prime.py
!scripts/next_k3_sieve.py
!scripts/deep_sieve.py
!scripts/googol_census.py
