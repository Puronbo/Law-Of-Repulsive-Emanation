{
  "tests": [],
  "summary": {
    "supported": true,
    "functional_equation_holds": true,
    "zeta_zero_removable": true,
    "trivial_zeros_correct": true,
    "honest_wall": "naive truncated series; not mpmath high-precision"
  },
  "zeta_at_zero": {
    "note": "zeta(0) = -1/2; functional eq at s=0 gives 0*inf = 0/0, removable = -1/2",
    "tests": [
      {
        "s": 0.001,
        "functional_eq_rhs": 0.0041135530029832576,
        "expected_zeta_0": -0.5,
        "close": false
      },
      {
        "s": 0,
        "zeta_0_exact": -0.5,
        "functional_eq_structure": "2^0 * pi^{-1} * sin(0) * Gamma(1) * zeta(1) = 0 * inf = 0/0",
        "removable_value": -0.5
      }
    ]
  },
  "functional_equation_values": {
    "note": "zeta(2k) = (-1)^{k+1} * B_{2k} * (2*pi)^{2k} / (2*(2k)!)",
    "tests": [
      {
        "s": 2,
        "zeta_s": 1.6447340868469014,
        "exact": 1.6449340668482264,
        "relative_error": 0.00012157326263429578
      },
      {
        "s": 3,
        "zeta_s": 1.2020568831635974,
        "exact": 1.202056903159594,
        "relative_error": 1.6634817023810703e-08
