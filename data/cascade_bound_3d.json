  "theorem_14": {
    "statement": "In 3D NS, the energy cascade gives ||u||_inf <= C*epsilon^{1/3} (Kolmogorov 1941). Combined with the dissipation wavenumber k_d = (epsilon/nu)^{1/4}, this gives R*nu*k_d^2 = O(1). Since k_d > 0 for all nu > 0, R is bounded. The 0/0 at blowup has removable value 0.",
    "key_inequality": "||u||_inf <= C * epsilon^{1/3}",
    "consequence": "R * nu * k_d^2 = O(1) => R bounded",
    "k_d_formula": "k_d = (epsilon/nu)^{1/4} = (2*nu*Z/nu)^{1/4} = (2*Z)^{1/4}"
  },
