  "exp_identity": {
    "note": "e^a * e^{-a} / e^0 = 1 at a=0: 0/0 removable value = 1",
    "tests": [
      {
        "a": 0.1,
        "b": -0.1,
        "lhs": 1.0,
        "rhs": 1.0,
        "ratio": 1.0,
        "is_one": true
      },
      {
        "a": 0.01,
        "b": -0.01,
        "lhs": 1.0,
        "rhs": 1.0,
        "ratio": 1.0,
        "is_one": true
      },
      {
        "a": 0.001,
        "b": -0.001,
        "lhs": 1.0,
        "rhs": 1.0,
        "ratio": 1.0,
        "is_one": true
      },
      {
        "a": 0.0001,
        "b": -0.0001,
        "lhs": 1.0,
        "rhs": 1.0,
        "ratio": 1.0,
        "is_one": true
      },
      {
        "a": 1e-05,
        "b": -1e-05,
        "lhs": 0.9999999999999999,
        "rhs": 1.0,
        "ratio": 0.9999999999999999,
        "is_one": true
      }
    ]
  },
  "algebraic_independence": {
