  "lindemann_weierstrass": {
    "note": "e and 2 are Q-linearly independent (a*e + b*2 != 0)",
    "tests": [
      {
        "coefficients": [
          1,
          0
        ],
        "value": 2.718281828459045,
        "is_zero": false,
        "linearly_independent": true
