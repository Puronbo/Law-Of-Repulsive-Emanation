digraph PunoCalculus {
  rankdir=LR;
  node [shape=box, style=rounded];
  bgcolor="transparent";
  fontname="Consolas";

  A1 [label="A1: Poincare metric", fillcolor="#4a90d9", style="filled,rounded", fontcolor="white"];
  A2 [label="A2: Hamilton's equations on T*D", fillcolor="#4a90d9", style="filled,rounded", fontcolor="white"];
  A3 [label="A3: PSL(2,Z) action via Cayley", fillcolor="#4a90d9", style="filled,rounded", fontcolor="white"];
  A4 [label="A4: He init: W ~ N(0, 2/fan_in)", fillcolor="#4a90d9", style="filled,rounded", fontcolor="white"];
  A5 [label="A5: Arithmetic: 2^n mod p cycles", fillcolor="#4a90d9", style="filled,rounded", fontcolor="white"];
  L1 [label="L1: He-init pre-activation variance", fillcolor="#50b86c", style="filled,rounded", fontcolor="white"];
  L2 [label="L2: ReLU norm contraction", fillcolor="#50b86c", style="filled,rounded", fontcolor="white"];
  L3 [label="L3: Maximum discrete entropy", fillcolor="#50b86c", style="filled,rounded", fontcolor="white"];
  T1 [label="T1: Conformal metric", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  T2 [label="T2: Geodesic distance", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  T3 [label="T3: Mobius disk closure", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  T4 [label="T4: Christoffel correction", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  T5 [label="T5: Symplectic structure", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  T6 [label="T6: Mersenne parity sieve", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  T7 [label="T7: Congruence sieve density", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  T8 [label="T8: C0 unification (V=H=Noether=WDW)", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  T9 [label="T9: Crease density bound", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  T10 [label="T10: Modular unification (5 domains)", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  C1 [label="C1: C0 is Stab(i)-invariant", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
  C2 [label="C2: Deep crease bound (depth-indep)", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
  C3 [label="C3: Dissipative crease convergence", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
  C4 [label="C4: Poincare recurrence", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
  C5 [label="C5: Bekenstein bound (geometric entropy)", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
  C6 [label="C6: Generalization gap bound", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
  C7 [label="C7: Prime geodesic bridge", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
  C8 [label="C8: Bidirectional coherence", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];

  A4 -> L1;
  A1 -> T1;
  T1 -> T2;
  T1 -> T3;
  T1 -> T4;
  A2 -> T4;
  T4 -> T5;
  A5 -> T6;
  T6 -> T7;
  T1 -> T8;
  T5 -> T8;
  T5 -> T9;
  L1 -> T9;
  A3 -> T10;
  T6 -> T10;
  T8 -> T10;
  T9 -> T10;
  T10 -> C1;
  T9 -> C2;
  L2 -> C2;
  T5 -> C3;
  T5 -> C4;
  C3 -> C4;
  C4 -> C5;
  L3 -> C5;
  T9 -> C6;
  T7 -> C7;
  T10 -> C7;
  A1 -> C8;
  A2 -> C8;
  A3 -> C8;
  A4 -> C8;
  A5 -> C8;
  L1 -> C8;
  L2 -> C8;
  L3 -> C8;
  T1 -> C8;
  T2 -> C8;
  T3 -> C8;
  T4 -> C8;
  T5 -> C8;
  T6 -> C8;
  T7 -> C8;
  T8 -> C8;
  T9 -> C8;
  T10 -> C8;
  C1 -> C8;
  C2 -> C8;
  C3 -> C8;
  C4 -> C8;
  C5 -> C8;
  C6 -> C8;
  C7 -> C8;
}
