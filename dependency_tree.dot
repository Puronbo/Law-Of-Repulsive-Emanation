  C8 [label="C8: Bidirectional coherence", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
  T19 [label="T19: Consistent chaos (geodesic flow embeds primes)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T20 [label="T20: Density matrix (cross-family independence)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T21 [label="T21: Lyapunov overdispersion (gap D >> 3)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T22 [label="T22: Sieve density as predictor (rho > 0.3)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
