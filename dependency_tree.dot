  T10 [label="T10: Modular unification (5 domains)", fillcolor="#e6a017", style="filled,rounded", fontcolor="white"];
  C1 [label="C1: C0 is Stab(i)-invariant", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
  C2 [label="C2: Deep crease bound (depth-indep)", fillcolor="#c0392b", style="filled,rounded", fontcolor="white"];
