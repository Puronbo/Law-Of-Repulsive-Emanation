  T24 [label="T24: Divisor cellular automaton (shift-register)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T25 [label="T25: Divisor gap kernel (coprime support)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T26 [label="T26: ω and Ω (Erdos-Kac chaos spectrum)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T27 [label="T27: Complete chaos spectrum (5 regimes)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T28 [label="T28: Chaos index C(f) = D_f / D_d (7 functions)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T29 [label="T29: Continuous spectrum d_t(n) (C(t) monotonic)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T30 [label="T30: Hardy-Littlewood k-tuple chaos", fillcolor="#999", style="filled,rounded", fontcolor="white"];
  T31 [label="T31: PNT window verification (Li < 0.1%)", fillcolor="#999", style="filled,rounded", fontcolor="white"];
